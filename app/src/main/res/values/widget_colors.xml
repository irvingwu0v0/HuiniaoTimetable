<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面控件配色（浅色）。
  API 34+ 通过 values-v34 使用系统动态取色；较低版本回退到固定配色，
  避免引用不存在的系统资源。
-->
<resources>
    <!-- 控件卡片背景 -->
    <color name="widget_background">#FFF3F5F8</color>
    <!-- 尚未开始的课程：常规前景色 -->
    <color name="widget_foreground">#FF1A1C1E</color>
    <!-- 已结束的课程 / 次要信息：弱化灰 -->
    <color name="widget_muted">#FF5D6168</color>
    <!-- 正在上课 / 接下来一节：强调色 -->
    <color name="widget_accent">#FF1A6FA3</color>
    <!-- 分隔线 -->
    <color name="widget_divider">#FFDDE1E7</color>
</resources>

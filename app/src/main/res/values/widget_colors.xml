<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面控件的 Material You 配色（浅色）。
  直接引用系统的动态取色语义色，随壁纸 / 主题自动变化，和 App 内的
  Material You（dynamicLightColorScheme）保持一致。
-->
<resources>
    <!-- 控件卡片背景 -->
    <color name="widget_background">@android:color/system_surface_container_high_light</color>
    <!-- 尚未开始的课程：常规前景色 -->
    <color name="widget_foreground">@android:color/system_on_surface_light</color>
    <!-- 已结束的课程 / 次要信息：弱化灰 -->
    <color name="widget_muted">@android:color/system_on_surface_variant_light</color>
    <!-- 正在上课 / 接下来一节：强调色 -->
    <color name="widget_accent">@android:color/system_primary_light</color>
    <!-- 分隔线 -->
    <color name="widget_divider">@android:color/system_outline_variant_light</color>
</resources>
